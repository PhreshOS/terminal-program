{
  "name": "terminal-program",
  "private": true,
  "version": "0.1.7",
  "description": "The official PhreshOS terminal Program.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "vite-node scripts/build.ts",
    "dev": "phresh dev",
    "start": "phresh start",
    "pack": "phresh pack",
    "verify": "node --run check && node --run build && vite-node scripts/verify-terminal.ts && vite-node scripts/verify-build.ts",
    "postinstall": "node scripts/prepare-node-pty.mjs"
  },
  "author": "Zohayr SLILEH",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhreshOS/terminal-program.git"
  },
  "bugs": {
    "url": "https://github.com/PhreshOS/terminal-program/issues"
  },
  "homepage": "https://github.com/PhreshOS/terminal-program#readme",
  "keywords": [
    "phreshos",
    "program",
    "terminal",
    "pty"
  ],
  "trustedDependencies": [
    "node-pty"
  ],
  "dependencies": {
    "@phreshos/client": "^0.1.25",
    "@phreshos/core": "^0.1.25",
    "@phreshos/server": "^0.1.26",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@phreshos/cli": "^0.1.37",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-node": "^6.0.0"
  }
}
